# Worker side (set on the GPU host, never in the EarnRoom app)
VIDEO_WORKER_TOKEN=              # long random string; the same value goes in EarnRoom
VIDEO_WORKER_MODEL=wan2.2-ti2v-5b
VIDEO_WORKER_DEVICE=cuda
VIDEO_WORKER_MAX_CONCURRENT_JOBS=1
VIDEO_WORKER_MAX_QUEUE_LENGTH=8
VIDEO_WORKER_MAX_JOBS_PER_DAY=6
VIDEO_WORKER_MAX_VIDEO_SECONDS=10
VIDEO_WORKER_BRAND_ASSET_DIR=/srv/brand
VIDEO_WORKER_OUTPUT_DIR=/srv/output
VIDEO_WORKER_STEPS=40
VIDEO_WORKER_GUIDANCE=5.0
VIDEO_WORKER_OFFLOAD=0           # 1 to trade speed for VRAM on a 24GB card

# EarnRoom side (set as backend secrets in the app, server-side only)
# VIDEO_WORKER_URL=https://wan.<your-host>
# VIDEO_WORKER_TOKEN=<same token as above>
# VIDEO_WORKER_MODEL=wan2.2-ti2v-5b
# VIDEO_INFRA_PENCE_PER_GPU_MINUTE=<your GPU rental cost in pence per minute>
